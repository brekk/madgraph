import { always } from "Function"
import String from "String"

import { between, stringTill } from "@/Parser/Combinators"
import { ARROW, LINE_END, NEWLINE, QUOTES } from "@/Parser/Constants"
import P from "@/Parsimony"



// ▚▚▚▚▚▚▚▚▚▚▚▚▚▚▚▚▚▚▚▚▚▚


// simple to start is better than nothing forever
export type Attribute = Attribute(String, String)
export type Comment = Comment(List String)
export type DotPart = Node(String, List Attribute) | Link(String, String) | GraphComment(Comment)
export alias DotList = List DotPart
export type DotLang = Digraph(String, List DotPart) | LangComment(Comment)
export alias Dot = List DotLang

singleLineComment :: P.Parser Comment
export singleLineComment = do {
  _ <- P.string("//")
  v <- stringTill(NEWLINE)
  return pipe(
    of,
    Comment,
    of,
  )(v)
}

link :: P.Parser DotPart
export link = do {
  a <- stringTill(ARROW)
  _ <- ARROW
  b <- stringTill(LINE_END)
  _ <- LINE_END
  return of(Link(a, b))
}

node :: P.Parser DotPart
export node = do {
  a <- stringTill(LINE_END)
  _ <- LINE_END
  return of(Node(a, []))
}

stringChar :: P.Parser Char
stringChar = P.choice([
  map(always('"'), P.string("\\\"")),
  map(always('\n'), P.string("\\n")),
  map(always('\t'), P.string("\\t")),
  P.notChar('"'),
])


string :: P.Parser (List Char)
export string = do {
  _ <- P.char('"')
  cs <- P.many(stringChar)
  _ <- P.char('"')

  return of(cs)
}

attribute :: P.Parser Attribute
export attribute = do {
  key <- stringTill(P.char('='))
  _ <- P.char('=')
  value <- map(String.fromList, P.choice([string, P.letters]))
  return of(Attribute(key, value))
}


nodeWithAttributes :: P.Parser DotPart
export nodeWithAttributes = do {
  a <- stringTill(P.char('['))
  _ <- P.char('[')
  attrs <- P.maybeSepBy(attribute, P.choice([P.char(','), P.char(' ')]))
  _ <- P.char(']')
  return of(Node(a, attrs))
}

export comment = P.choice([singleLineComment])

graphComment :: P.Parser DotPart
export graphComment = do {
  x <- comment
  return of(GraphComment(x))
}

nodule :: P.Parser DotPart
export nodule = P.choice([graphComment, link, nodeWithAttributes, node])

digraph :: P.Parser DotLang
export digraph = do {
  _ <- P.choice([P.symbol("digraph"), P.symbol("Digraph")])
  name <- stringTill(P.char('{'))
  _ <- P.char('{')
  body <- P.token(P.someTill(nodule, P.char('}')))
  _ <- P.char('}')
  return of(Digraph(name, body))
}
